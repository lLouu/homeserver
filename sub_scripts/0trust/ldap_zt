# Allow ansible to run only specific commands
ansible ALL=(root) NOPASSWD: \
   /sbin/apk add openldap openldap-back-mdb openldap-clients, \
   /usr/bin/install -m 755 -o ldap -g ldap -d /etc/openldap/slapd.d, \
   /usr/bin/install -m 755 -o ldap -g ldap -d /var/lib/openldap/run, \
   /bin/rm /etc/openldap/slapd.conf, \
   \
   /bin/sed -i 's/cfgfile\=.*$/cfgdir\=slapd.d/' /etc/conf.d/slapd, \
   /bin/sed -i 's/^olcSuffix\:.*$/olcSuffix\: dc\=home\,dc\=lab/' /etc/openldap/slapd.ldif, \
   /bin/sed -i 's/^olcRootDN\:.*$/olcRootDN\: cn\=Manager\,dc\=home\,dc\=lab/' /etc/openldap/slapd.ldif, \
   /bin/sed -i "s/^olcRootPW\:.*$/olcRootPW\: .*/" /etc/openldap/slapd.ldif, \
   \
   /usr/sbin/slapadd -n 0 -F /etc/openldap/slapd.d -l /etc/openldap/slapd.ldif, \
   /sbin/rc-service slapd start, \
   /sbin/rc-update add slapd



